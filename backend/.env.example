# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
API_V1_PREFIX=/api
# Comma-separated list of allowed CORS origins (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Security / JWT ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/login/callback

# ── Database ──────────────────────────────────────────────────────────────────
# Postgres (via docker-compose). For a zero-infra local run use e.g.
#   DATABASE_URL=sqlite+pysqlite:///./codeatreus.db
DATABASE_URL=postgresql+psycopg://codeatreus:codeatreus@localhost:5432/codeatreus

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Vector store (ChromaDB) ───────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma

# ── Embeddings ────────────────────────────────────────────────────────────────
# Provider: "fastembed" (local), "jina", or "openai-compatible"
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
JINA_API_KEY=

# ── LLM (OpenRouter, OpenAI-compatible) ───────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free models work well for the demo:
LLM_MODEL=nvidia/nemotron-3.5-lightning:free

# ── Clone/index guardrails ────────────────────────────────────────────────────
CLONE_DIR=./data/repos
MAX_REPO_SIZE_MB=200
MAX_FILE_SIZE_KB=1024
CLONE_TIMEOUT_SECONDS=120
